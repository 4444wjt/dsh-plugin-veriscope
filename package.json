{
  "name": "dsh-plugin-veriscope",
  "version": "0.3.1",
  "private": true,
  "description": "Offline VeriScope Quality Gate replay for DeepSeek Harness (DSH).",
  "author": {
    "name": "4444wjt"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/4444wjt/dsh-plugin-veriscope.git"
  },
  "bugs": {
    "url": "https://github.com/4444wjt/dsh-plugin-veriscope/issues"
  },
  "homepage": "https://github.com/4444wjt/dsh-plugin-veriscope#readme",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "contracts",
    "skills",
    "cordis.patch.yml",
    "scripts/replay.mjs",
    "client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test",
    "replay": "node scripts/replay.mjs",
    "verify:replay": "node scripts/verify-replay.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
